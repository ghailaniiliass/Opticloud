# Copiez ce fichier en `.env` puis renseignez vos valeurs. Le vrai .env n'est jamais versionné.
# Pas de commentaire en fin de ligne : écrivez-les sur leur propre ligne, comme ici.
# Gardez la SECRET_KEY entre guillemets simples (elle peut contenir $ ou #).
SECRET_KEY='remplacez-par-une-cle-aleatoire'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base Django (compte lecture/écriture) ---
DB_NAME=opti_cloud
DB_USER=opticloud
DB_PASSWORD=MotDePasseRW
DB_HOST=127.0.0.1
# Vérifiez le port de votre serveur avec : SELECT @@port;
DB_PORT=3306
# En production cloud (MySQL avec TLS obligatoire : Aiven, TiDB Cloud, PlanetScale, Railway…), activez DB_SSL=True
DB_SSL=False
# Alternative en une seule variable sur Vercel : DATABASE_URL=mysql://user:password@host:port/dbname

# --- Copie de travail du dump (compte LECTURE SEULE) ---
LEGACY_DB_NAME=opti_cloud_legacy
LEGACY_DB_USER=opticloud_ro
LEGACY_DB_PASSWORD=MotDePasseRO

# --- Archive des originaux : dossier HORS du projet (utilisez des / même sous Windows) ---
ARCHIVE_DIR=C:/OptiCloud_Archives

# --- Bases que la migration refuse de toucher (séparées par des virgules) ---
PROTECTED_DATABASES=opti cloud

# --- Facultatif : valeurs de VOTRE base à signaler comme « ressemblant à des essais » dans le rapport de migration (séparées par des virgules) ---
# TEST_LIKE_VALUES=
